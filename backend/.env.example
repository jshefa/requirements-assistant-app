# Copy this file to .env and fill in your values.
# The app does NOT require these — users enter their API key in the browser.
# These are optional server-side defaults only.

# AI Provider — set to: anthropic | openai | ollama
AI_PROVIDER=anthropic

ANTHROPIC_MODEL="claude-opus-5"
OPENAI_MODEL="gpt-5.6-sol"

# Ollama settings (only used when AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL="gemma3:12b"

# prototype or research
APP_MODE=prototype

# set your access if you want to require a password for access to the site 
ACCESS_CODE="password"

DATABASE_URL=postgres_url_here

# debug only - reads response from json instead of an actual ai call. intended for the point mass dataset
MOCK_AI=false